{
  "manifest_version": 3,
  "name": "ScreenText AI - Screen-to-Text OCR",
  "version": "1.0.0",
  "description": "Turn anything on your screen into editable text. Capture tabs or select areas with 100% on-device OCR.",
  "author": "ScreenText AI",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScreenText AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "lib/*",
        "lib/lang/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
